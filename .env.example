# Base URL for the application (used in SEO meta tags)
VITE_BASE_URL=https://nexus.lovable.app

# VAPID keys for push notifications (optional)
# Generate using: npx web-push generate-vapid-keys
# VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# ─── PayFast Payment Gateway ─────────────────────────────────────────────────
# Set VITE_PAYFAST_SANDBOX=false and supply live credentials for production.
# Sandbox credentials are pre-filled for development/testing purposes.
VITE_PAYFAST_SANDBOX=true
VITE_PAYFAST_MERCHANT_ID=10000100
VITE_PAYFAST_MERCHANT_KEY=46f0cd694581a
# VITE_PAYFAST_PASSPHRASE=          # Only needed if a passphrase is set on the PayFast account
# VITE_PAYFAST_NOTIFY_URL=https://yourdomain.com/api/payfast/notify
